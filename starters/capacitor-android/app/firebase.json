{
  "hosting": {
    "public": "hosting",
    "ignore": ["firebase.json", "**/.*"],
    "headers": [
      {
        "source": "/updates/latest.json",
        "headers": [{ "key": "Cache-Control", "value": "no-cache, max-age=0" }]
      },
      {
        "source": "/updates/**",
        "headers": [{ "key": "Access-Control-Allow-Origin", "value": "*" }]
      }
    ]
  }
}
